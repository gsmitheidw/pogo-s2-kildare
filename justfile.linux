
build:
    python s2.py
    git add index.html
    git commit -m 'Update index'
    git push

clean:
    rm -f index.html

rebuild: clean build

csv:
    git add kildare_poi.csv
    git commit -m 'update csv'
    git push


validate:
    python validate_csv.py 


s2:                                                                                                                        git add s2.py                                                                                                          git commit -m 'News update'                                                                                            git push                                                                                                                                                                                                                                  news: s2 rebuild
